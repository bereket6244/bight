{
  "name": "bight",
  "version": "1.3.0",
  "description": "Bight - board sight. An offline chess coordinate and board-vision trainer.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --reporter=verbose",
    "cap:sync": "cap sync android",
    "android:build": "node scripts/sync-version.mjs && node scripts/build-apk.mjs",
    "android:release": "node scripts/build-apk.mjs --release",
    "fetch:voice-model": "node scripts/fetch-voice-model.mjs",
    "verify": "node scripts/sync-version.mjs --check && node scripts/generate-icons.mjs --check && npm run lint && npm run typecheck && npm run test",
    "setup": "node scripts/setup.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "inspect:apk": "node scripts/inspect-apk.mjs",
    "test:browser": "node scripts/browser-tests.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "chess.js": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^5.0.2",
    "jsdom": "^25.0.1",
    "puppeteer": "^23.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
